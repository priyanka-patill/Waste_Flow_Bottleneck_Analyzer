# WasteWise API Configuration Keys

# India Open Government Data Platform Key (data.gov.in)
VITE_DATAGOV_API_KEY=

# OpenAQ Ambient Air Quality API Key
VITE_OPENAQ_API_KEY=

# Leaflet Map Tile Provider URL (Optional, defaults to OpenStreetMap)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Optional Live Commercial Traffic Provider API Key
VITE_TRAFFIC_API_KEY=
