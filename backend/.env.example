# WasteWise Backend Configuration

# Server Settings
PORT=8000
HOST=0.0.0.0
ENV=development

# Database URL (SQLite for dev, PostgreSQL compatible)
DATABASE_URL=sqlite:///./wastewise.db

# External API Keys (Backend-only security)
DATAGOV_API_KEY=
OPENAQ_API_KEY=

# Base URLs
OSRM_BASE_URL=https://router.project-osrm.org
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
